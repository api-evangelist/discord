          "request": {
            "name": "Discord Receive webhook event",
            "description": {
              "content": "Endpoint on your server that receives webhook events from Discord. Discord sends a POST request with the event payload. Your server must respond with a 204 No Content for successful processing. Discord validates the endpoint using Ed25519 signatures.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "discord-webhook"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
