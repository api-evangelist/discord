{
  "opencollection": "1.0.0",
  "info": {
    "name": "Discord Interactions Application Commands Audit Log API",
    "version": "10"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Audit Log",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Discord Get guild audit log",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://discord.com/api/v10/guilds/:guild_id/audit-logs",
            "params": [
              {
                "name": "guild_id",
                "value": "",
                "type": "path",
                "description": "The ID of the guild (Snowflake)"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "action_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "before",
                "value": "",
                "type": "query"
              },
              {
                "name": "after",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns an audit log object for the guild."
        }
      ]
    }
  ],
  "bundled": true
}